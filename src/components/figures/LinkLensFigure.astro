---
import { getImage } from 'astro:assets';
import report from '../../assets/work/linklens-report.jpg';
import reportPhone from '../../assets/work/linklens-report-phone.jpg';

// Wide screens get the whole report; phones get the verdict card alone, which stays readable.
const wide = await getImage({ src: report, widths: [700, 1100, 1600, 2200], format: 'webp' });
const phone = await getImage({ src: reportPhone, widths: [400, 700, 944], format: 'webp' });
---

<figure>
  <picture>
    <source
      media="(max-width: 640px)"
      srcset={phone.srcSet.attribute}
      sizes="calc(100vw - 40px)"
      width={reportPhone.width}
      height={reportPhone.height}
    />
    <img
      src={wide.src}
      srcset={wide.srcSet.attribute}
      sizes="(min-width: 1100px) min(1100px, 80vw), calc(100vw - 40px)"
      width={report.width}
      height={report.height}
      alt="LinkLens scan report: likely dangerous, risk score 100 of 100, malware download, with each reason and its points."
      loading="lazy"
      decoding="async"
    />
  </picture>
  <figcaption>
    A saved LinkLens report. The link is Google’s Safe Browsing test page, which exists to be flagged.
  </figcaption>
</figure>

<style>
  img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    background: #0b1020;
  }

  figcaption {
    margin-top: 12px;
    font-size: var(--step-small);
    color: var(--muted);
  }
</style>
