---
import { getImage } from 'astro:assets';
import consoleShot from '../../assets/work/ulpf-console.png';
import consolePhone from '../../assets/work/ulpf-console-phone.png';

// Phones get the console's counters alone; the event table is unreadable at that width.
const wide = await getImage({ src: consoleShot, widths: [700, 1100, 1440], format: 'webp' });
const phone = await getImage({ src: consolePhone, widths: [400, 708], format: 'webp' });
---

<figure>
  <picture>
    <source
      media="(max-width: 640px)"
      srcset={phone.srcSet.attribute}
      sizes="calc(100vw - 40px)"
      width={consolePhone.width}
      height={consolePhone.height}
    />
    <img
      src={wide.src}
      srcset={wide.srcSet.attribute}
      sizes="(min-width: 1100px) min(1100px, 80vw), calc(100vw - 40px)"
      width={consoleShot.width}
      height={consoleShot.height}
      alt="ULPF operator console: 1,180 events received, 1,174 normalised to OCSF in this session, and a live table of Snort, Proxifier, Sendmail, Apache and iptables events."
      loading="lazy"
      decoding="async"
    />
  </picture>
  <figcaption>
    ULPF’s operator console during one replay session. Screenshot by the ULPF contributors, Apache-2.0.
  </figcaption>
</figure>

<style>
  img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  figcaption {
    margin-top: 12px;
    font-size: var(--step-small);
    color: var(--muted);
  }
</style>
