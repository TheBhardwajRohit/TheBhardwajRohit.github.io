---
import { record } from '../data/site.ts';
---

<section class="section frame" id="record" aria-labelledby="record-title" tabindex="-1">
  <div class="record">
    <h2 id="record-title" class="section-title" data-reveal>Record</h2>
    <div class="groups">
    {
      record.map((group, g) => (
        <section class="group" aria-labelledby={`record-${g}`} data-reveal>
          <h3 id={`record-${g}`} class="group-title">
            {group.title}
          </h3>
          <ul>
            {group.rows.map((row) => (
              <li>
                <div class="row-main">
                  <p class="row-name">{row.name}</p>
                  {row.detail && <p class="row-detail">{row.detail}</p>}
                </div>
                <p class="row-value">{row.value}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    </div>
  </div>
</section>

<style>
  .record {
    margin-left: var(--indent);
  }

  .groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 44px;
    max-width: var(--column);
  }

  @media (min-width: 1100px) {
    .groups {
      grid-template-columns: minmax(0, var(--column)) minmax(300px, 1fr);
      column-gap: clamp(48px, 5vw, 88px);
      row-gap: 44px;
      max-width: none;
    }
  }

  .group-title {
    font-size: var(--step-small);
    letter-spacing: 0;
    color: var(--muted);
    margin-bottom: 8px;
  }

  li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 24px;
    align-items: baseline;
    padding-block: 10px;
  }

  .row-name {
    font-weight: 500;
  }

  .row-detail {
    margin-top: 2px;
    max-width: 40em;
  }

  .row-value {
    color: var(--muted);
    font-size: var(--step-small);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 560px) {
    li {
      grid-template-columns: 1fr;
    }

    .row-value {
      grid-row: 1;
      white-space: normal;
    }
  }
</style>
