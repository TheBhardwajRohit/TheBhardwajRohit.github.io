---
import LinkCheck from './LinkCheck.astro';
import { highlights, person } from '../data/site.ts';
---

<section class="hero frame" aria-labelledby="hero-title">
  <div class="hero-grid">
    <h1 id="hero-title" data-reveal>I build tools that catch&nbsp;scams.</h1>
    <div class="hero-main">
      <p class="lead hero-sub" data-reveal style="--i: 1">
        I’m {person.name}, a final-year B.Tech student in Cyber Security at {person.university}, working on phishing,
        fraud and attacks on AI systems.
      </p>
      <div class="hero-actions" data-reveal style="--i: 2">
        <a class="button" href={person.resume.href} download={person.resume.file}>Download resume</a>
        <a class="text-link" href={`mailto:${person.email}`}>Email me</a>
      </div>
      <table class="facts" data-reveal style="--i: 3">
        <caption class="sr-only">Record at a glance</caption>
        <tbody>
          {
            highlights.map((h) => (
              <tr>
                <th scope="row">
                  <a href={h.href}>{h.label}</a>
                </th>
                <td class="data">{h.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="hero-demo" data-reveal style="--i: 2">
      <LinkCheck />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(56px, 11vh, 140px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-left: var(--indent);
  }

  h1 {
    font-size: var(--step-display);
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 9em;
    margin-bottom: clamp(20px, 2.4vw, 32px);
  }

  .hero-main {
    max-width: var(--column);
  }

  .hero-sub {
    max-width: 30em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(28px, 3vw, 40px);
  }

  .facts {
    margin-top: clamp(40px, 5vw, 56px);
    font-size: var(--step-small);
  }

  .facts tr {
    border-top: 1px solid var(--rule);
  }

  .facts tr:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .facts th,
  .facts td {
    padding: 11px 0;
    vertical-align: baseline;
    text-align: left;
  }

  .facts th {
    font-weight: 500;
    padding-right: 24px;
    white-space: nowrap;
  }

  .facts th a {
    text-decoration: none;
  }

  .facts th a:hover {
    text-decoration: underline;
  }

  .facts td {
    font-size: 0.8125rem;
    text-align: right;
  }

  .hero-demo {
    max-width: var(--column);
    margin-top: clamp(56px, 8vw, 88px);
  }

  @media (min-width: 1200px) {
    .hero-grid {
      grid-template-columns: minmax(0, var(--column)) minmax(380px, 460px);
      column-gap: clamp(48px, 5vw, 96px);
      align-items: start;
    }

    h1 {
      grid-column: 1 / -1;
    }

    .hero-demo {
      max-width: none;
      margin-top: 8px;
    }
  }

  @media (max-width: 520px) {
    .facts th {
      white-space: normal;
    }

    .facts tr {
      display: grid;
      gap: 2px;
      padding: 10px 0;
    }

    .facts th,
    .facts td {
      padding: 0;
      text-align: left;
    }
  }
</style>
