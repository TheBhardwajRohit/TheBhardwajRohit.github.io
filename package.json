{
  "name": "rohit-bhardwaj-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of Rohit Bhardwaj, cyber security student.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run fonts && astro dev",
    "fonts": "node scripts/fetch-fonts.mjs",
