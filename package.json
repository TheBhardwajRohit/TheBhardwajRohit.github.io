    "preview": "astro preview",
    "check": "astro check && eslint . --max-warnings 0",
    "test": "node --test \"tests/**/*.test.ts\"",
    "qa": "node qa/audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
