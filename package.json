    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "playwright-core": "1.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
